    "next": "^16.3.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.22.0",
    "pg-boss": "^12.25.1",
    "pino": "^10.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
