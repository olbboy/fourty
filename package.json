  "private": true,
  "license": "BUSL-1.1",
  "description": "Fourty \u2014 The open-source CRM that deploys in 30 seconds. Twice the CRM, half the complexity.",
  "//types": "Read only by the design-system export (see .design-sync/NOTES.md), which needs a declaration entry to discover the component surface. The app never imports this; the file is generated, not committed.",
  "types": ".design-sync/.cache/types/.design-sync/ds-entry.d.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "db:e2e:setup": "bash scripts/e2e-db-setup.sh",
    "db:e2e:reset": "tsx e2e/prepare-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "migrate-from-sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "rekey": "tsx scripts/rekey.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup-drill": "bash scripts/backup-drill.sh",
    "build:brand": "tsx scripts/build-brand-assets.ts",
    "build:ds-foundations": "tsx scripts/build-ds-foundations.ts",
    "build:ds-screens": "tsx scripts/build-ds-screens.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
