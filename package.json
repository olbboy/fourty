    "@types/node": "^22.15.32",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.16.2",
